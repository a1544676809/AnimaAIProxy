<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AnimaAIProxy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!--
      ImplicitUsings / LangVersion 是**必须的**，不是顺手加的：
      Core/ 与 Vendor/ 下的源码是按"隐式 using 已开"写的（`Task`、
      `HttpClient`、`HashSet<>`、`StringComparer` 这些一律没写 using，
      与 AnimaCaptioner 原仓库的约定一致，见 tests/proxycheck.csproj）。
      模板默认不开，于是本工程会把整片 Core/ 编译成一堆
      "未能找到类型或命名空间名 Task" —— 症状看起来像缺包，其实是缺开关。
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      以**非打包（unpackaged）**方式运行。WindowsPackageType=None 是必须的：
      直接跑 MSIX 打包工程产出的那个 exe 会在启动瞬间抛
      REGDB_E_CLASSNOTREG (0x80040154)，堆栈落在
      WindowsAppRuntime.DeploymentInitializeOptions —— 因为打包应用的 exe
      没有包标识（package identity）。

      **Windows App SDK 走框架依赖，不自带。** 实测（进程模块表，非推断）：
      应用从
        C:\Program Files\WindowsApps\Microsoft.WindowsAppRuntime.2_2.5.1.0_x64__8wekyb3d8bbwe\
      加载 Microsoft.UI.Xaml.dll / Microsoft.UI.Xaml.Controls.dll /
      CoreMessagingXP.dll，窗口渲染、托盘、/health 全部正常。
      输出目录 **156 MB → 42 MB**，与 AnimaCaptioner（41 MB / 70 文件）持平。

      为什么以前是 true：那时框架依赖会在启动瞬间抛 REGDB_E_CLASSNOTREG，
      于是改成自带运行时绕开。现在本机已装匹配的
      Microsoft.WindowsAppRuntime.2（2.5.1.0），那条理由不再成立。

      自带究竟贵在哪（156 MB 的构成）：WinAppSDK 2.x 是**组件化元包**，
      Microsoft.WindowsAppSDK 2.5.1 把 Base/Foundation/WinUI/DWrite/
      InteractiveExperiences **以及 AI + ML + Search + Widgets** 一起拉进来。
      自带时这后四个会整体落进输出目录，共 47 个文件 / **55.7 MB**
      （onnxruntime.dll 20.7 + DirectML.dll 17.8 + SemanticIndex.AiFabric 3.8
      + Windows.Search 3.3 + …），而本代理一个 API 都不调它们。

      代价是刻意的，与 AnimaCaptioner 同一取舍：目标机需要
      **Windows App Runtime 2.x（2.5.1）+ .NET 10 Desktop Runtime**。
      要发到没装运行时的机器上，把下面这行改回 true 即可 ——
      代码一行都不用改，代价是输出目录回到约 156 MB。
      Package.appxmanifest 仍留在仓库里：哪天要出 MSIX 包，
      把这两个属性去掉即可。
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!--
      **不自带 .NET。** 本机装了 .NET 运行时，把 coreclr /
      System.Private.CoreLib 一起塞进输出目录没有任何收益，只会让目录从
      几十 MB 涨到 250 MB、每次构建都慢一截。
      WindowsAppSDKSelfContained 一旦打开，会**隐式**把 SelfContained 也
      打开——所以上面那行无论取值如何，这一行都必须显式写 false。
      不写的症状是"输出目录里莫名其妙多出一整套 .NET 运行时"，没有任何提示。
    -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!--
    Vendored 的 seed 母本（从 AnimaCaptioner 的 vocab/seed.json 原样搬入，
    来源 commit 见 Vendor/AnimaCaptioner/VENDOR.md）。

    **为什么它必须在输出目录里**：seed 是人工整理的"中文概念 → 标签"补充映射，
    词库里本来就查不到的那些词全靠它（`银发 → silver hair`、`咖啡厅 → cafe`
    这类）。而 `ProxyConfig.DefaultSeedPath()` 在借不到 AnimaCaptioner 的配置时
    会回落到这一份 —— 从此"只装代理、没装上游软件"的机器也能拿到同一套映射，
    而不是静默地没有 seed（症状是中文查询质量悄悄变差，且没有任何报错）。

    放到 vocab\ 子目录、与应用自己的 `%LOCALAPPDATA%\AnimaAIProxy\vocab\seed.json`
    保持同一形状，两个路径不会混。
  -->
  <ItemGroup>
    <Content Include="Vendor\AnimaCaptioner\seed.json">
      <Link>vocab\seed.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    tests/ 是**另一个工程**（tests/proxycheck.csproj），它自己用相对路径把
    Core/ 与 Vendor/ 的真实源文件 Compile Include 进去。默认的通配会把
    tests/ 下的源文件——尤其是 tests/obj/ 里那些自动生成的 AssemblyInfo——
    一起吸进本工程，症状是一堆"特性重复"（CS0579）加一个莫名其妙的
    XamlCompiler WMC9999，而根因和 XAML 毫无关系。这里明确切掉整棵子树。
  -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!--
      vendored 的 VocabDb 直接读 SQLite，所以应用本体也需要它。
      版本与 tests/proxycheck.csproj **必须一致**：两处不同的话，
      "回归里跑过的代码路径"和"应用实际跑的那套托管依赖"就不是同一套了，
      而这类差异的表现是"测试全过、应用一查库就炸"。
      本 TFM 是 net10.0，所以取 10.0.x 线，与 AnimaCaptioner 用的同一版
      （AnimaCaptioner.csproj:45 也是 10.0.12）——两边读的**同一个 113 MB 词库**，
      托管依赖版本不一致没有任何好处。（该包只有 netstandard2.0 资产，8.0/10.0
      两条线都能装，但版本对齐比"能装上"重要。）
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!--
      web_fetch 的正文提取要用它。选它的理由只有一条：**本地 NuGet 缓存里已有
      1.11.71**（离线可建），而 AngleSharp / SmartReader / ReverseMarkdown 都不在。
      SmartReader（Mozilla Readability 的 .NET 移植）提取质量确实更好，但为了它
      新增一个必须联网下载的依赖不划算 —— 本项目一直保持"缓存里有什么用什么"。
      容错性也够：HtmlAgilityPack 对畸形 HTML 的容忍度是它最强的部分，
      而我们要抓的正是各种不规范的真实网页。
    -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <!--
      托盘图标。版本 2.4.1 的 lib 是 net10.0-windows10.0.17763 —— 正是本 TFM
      所在的那条线。**这条约束是双向的**：以前本 TFM 是 net8.0 时，2.4.1 会
      NU1202（不兼容），只能停在 2.3.0；迁到 net10.0 后反过来，2.3.0 那条
      net8.0 lib 虽仍能被 net10 工程引用，但没必要留在旧线上。
      改 TFM 时记得同步复核这一行。
    -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <!--
    代理的 HTTP 服务层用 Kestrel。**刻意不用 ASP.NET Core 的 Web SDK**：
    那会把 OutputType 变成 Exe、接管 Program.Main，与 WinUI 的入口打架。
    这里只借共享框架（Microsoft.AspNetCore.App），入口仍然是 WinUI 的，
    由我们自己 new 一个 WebApplication 出来。
    已在 WinUI 的 TFM（net10.0-windows10.0.19041.0）下实测过：进程内起
    Kestrel 能被子进程/外部客户端访问，SSE 也正常回流。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    发布属性。这两项都**不能**沿用模板默认值 —— 模板是按"独立 + 可裁剪"的
    普通应用写的，而这里是一个**框架依赖的 WinUI 3** 应用。

    ① PublishTrimmed 必须是 false。模板在非 Debug 下写的是 true，
       而裁剪要求发布的是独立应用，与 <SelfContained>false</SelfContained>
       撞在一起会让 `dotnet publish -c Release` **直接失败、一个文件都不产出**：
         error NETSDK1102: 所选发布配置不支持优化程序集的大小。请确保你发布的是独立应用。
       （实测于本仓库；这条一直藏着，因为平时只用 dotnet build。）
       即使去掉框架依赖改成独立，裁剪对 WinUI 3 也是**不受支持**的：XAML 类型靠
       反射解析，被裁掉的表现是运行期 "Cannot find a resource with the given key"。
       本项目还有 System.Text.Json 反射序列化（构建时那批 IL2026 就是它在报警）。
       **体积不靠裁剪来省** —— 省体积靠 WindowsAppSDKSelfContained=false，
       那是 156 MB → 42 MB 的那一刀。

    ② PublishReadyToRun 保持 false。R2R 是拿体积换启动时间的：把 IL 预编译成原生码
       塞进每个程序集。本代理的启动开销几乎全在加载 113 MB 词库（约 1.5 s），
       R2R 对那一段毫无帮助，却会让发布目录明显变大。AnimaCaptioner 也没开。
  -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    **这里刻意没有 CopyAppPriToPublish。**

    AnimaCaptioner / DshBroker 都带一个同名 target，用来补 WinUI 3 + unpackaged
    + dotnet publish 的已知缺陷（应用自己的 .pri 只生成在 bin\，不进发布目录，
    症状是发布版一碰 XAML 资源就报 "Cannot find a resource with the given key"）。
    本工程**实测不需要它**，所以没有照抄 —— 加了就是一段永不生效、还会误导
    后来人的死代码（"有 target 兜着"会让人以为这里也有那个缺陷）。

    实测（不是推断）：把该 target 去掉后发布，两种发布模式各测一次 ——
      框架依赖  dotnet publish -c Release -r win-x64 -p:Platform=x64
      自带运行时 再加 -p:WindowsAppSDKSelfContained=true
    两次的发布目录里都有 AnimaAIProxy.pri，**11224 字节，与 bin\ 下的同名文件
    字节数一致**，且文件内确实含 .xbf 与 MainWindow 条目（是真资源不是空壳）。
    -v n 日志里那行拷贝来自 SDK 自己的发布路径，不是我们的 target：
      正在将文件从"...\bin\x64\Release\...\win-x64\AnimaAIProxy.pri"
              复制到"...\AnimaAIProxy.pri"。

    更关键的是**跑起来验证过**：用去掉 target 后的发布产物启动，
    MainWindowHandle 非 0（XAML 真的加载并建出窗口），/health 返回
    {"status":"ok","vocabReady":true}，没有 "Cannot find a resource" 之类报错。

    也就是说：那个缺陷要么不适用于本工程，要么已被当前 SDK 修掉。哪一天真在
    发布版上撞到 "Cannot find a resource with the given key"，再把那个 target
    加回来即可 —— 它是无害的（SkipUnchangedFiles，内容一致时什么都不做）。
  -->

  <!--
    **发布目录里剔除 Windows ML 的原生负载（onnxruntime + DirectML，共 39.4 MB）。**
    本代理一个 Windows ML / Windows AI API 都不调用，这些 DLL 纯属搭车。

    为什么非写这一段不可：WindowsAppSDKSelfContained=false 已经让 **build** 不带它们了，
    但 **publish 照样会带** —— 这是 Microsoft 自己 targets 的漏洞：
    Microsoft.WindowsAppSDK.ML 里的 _SuppressWindowsMLNativeCopyLocalNative 只在
    ResolveNuGetPackageAssets → _CopyFilesMarkedCopyLocal 这条 **build** 路径上
    摘掉了这些原生资产，而 publish 走的是 ComputeResolvedFilesToPublishList →
    ResolvePublishAssemblies 那条路，没人管。症状就是"build 42 MB、publish 81 MB"，
    多出来的正好是 onnxruntime.dll 20.7 + DirectML.dll 17.8 +
    Microsoft.Windows.AI.MachineLearning.dll 0.9。

    试过但**实测无效**的两个官方开关（不是推断）：
      WindowsAppSDKMLPassthroughOnnxRuntime=true   → 仍是 81.5 MB
      DisableWindowsAppSDKMLAutoInitialize=true     → 仍是 81.5 MB
    它们只改 C++ 侧的 auto-initializer 选择，管不到 C# 项目的 NuGet 资产拷贝。

    **这个 target 确实在干活，不是死代码** —— 与上面刻意删掉的 CopyAppPriToPublish
    同一套标准验证过（把 AfterTargets/BeforeTargets 同时改成不存在的名字使其失效，
    再发布一次；两个钩子必须都改，只改一个 target 仍会因 BeforeTargets 触发）：
      失效时  62 文件 / **81.5 MB**，onnxruntime.dll 20.66 + DirectML.dll 17.83 回来了
      生效时  59 文件 / **42.1 MB**，两者都不在
    差的 39.4 MB 就是这三行 Remove 省下来的。验证后已按原始字节还原（无残留）。

    按**元数据**筛，不按文件名筛：AssetType=native + NuGetPackageId=...。
    托管的 Microsoft.ML.OnnxRuntime.dll / *.Projection.dll（合计约 0.3 MB）**留着** ——
    build 输出里本来就有，删掉会让 publish 与 build 不一致，得不偿失。
  -->
  <Target Name="DropUnusedWindowsMLPayloadFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="CopyFilesToPublishDirectory">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' and '%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
    </ItemGroup>
  </Target>
</Project>