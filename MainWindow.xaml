<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnimaAIProxy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AnimaAIProxy"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AnimaAIProxy">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            托盘图标：只是个载体，不渲染。图标由 GeneratedIconSource 现画，不依赖 .ico。

            菜单项**只给 x:Name、不给 Click**：默认的 ContextMenuMode=PopupMenu 会把
            这个 MenuFlyout 交给 Win32 菜单模拟，而它只认每项上的 Command（由
            MainWindow 构造函数里的 WireTrayCommands 接上）。绑 Click 的话菜单照常
            弹出、每项都能点，但没有任何代码会执行。
        -->
        <tb:TaskbarIcon x:Name="Tray" Grid.Row="0" ToolTipText="AnimaAIProxy"
                        MenuActivation="RightClick" NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="AIP" Background="#1F6FEB" Foreground="White"
                                        FontSize="26" CornerRadius="4" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayShowItem" Text="显示窗口" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayStartItem" Text="启动代理" />
                    <MenuFlyoutItem x:Name="TrayStopItem" Text="停止代理" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayExitItem" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ================= 顶部状态条 ================= -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="已停止" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="UptimeText" Text="" Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Base URL" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock x:Name="BaseUrlText" Text="—" IsTextSelectionEnabled="True"
                                   FontFamily="Consolas" VerticalAlignment="Center" />
                        <Button x:Name="CopyBaseUrlButton" Content="复制"
                                Click="CopyBaseUrl_Click" Padding="8,2" />
                    </StackPanel>

                    <TextBlock x:Name="HintText" Opacity="0.6" TextWrapping="Wrap" Text="" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="ToggleButton" Content="启动代理"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Toggle_Click" MinWidth="120" />

                <Button Grid.Column="2" x:Name="SaveButton" Content="保存设置"
                        Click="Save_Click" MinWidth="100" />
            </Grid>
        </Border>

        <!-- ================= 下面几块 ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!-- ===== 模型提供商 ===== -->
                <Expander Header="模型提供商" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <TextBlock x:Name="ProviderSummaryText" Opacity="0.7" TextWrapping="Wrap" Text="" />

                        <!-- 可选中：下面的"手工添加模型"要有个明确的目标站点。 -->
                        <ListView x:Name="ProviderList" SelectionMode="Single" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ProviderRow">
                                    <!-- AutomationProperties.Name：不设的话读屏器念的是内部类型名。 -->
                                    <Grid ColumnSpacing="10" Padding="0,6"
                                          AutomationProperties.Name="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                                  Click="ProviderEnabled_Changed"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="启用此站点" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{x:Bind DefaultMark}"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="设为默认"
                                                Click="SetDefaultProvider_Click"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="编辑"
                                                Click="EditProvider_Click"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Content="删除"
                                                Click="DeleteProvider_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="AddProviderButton" Content="新增站点"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="AddProvider_Click" />
                            <Button Grid.Column="1" x:Name="RefreshModelsButton" Content="刷新模型"
                                    Click="RefreshModels_Click" />
                            <TextBlock Grid.Column="2" x:Name="ProviderStatusText" Opacity="0.7"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Text="" />
                        </Grid>

                        <NumberBox x:Name="TimeoutBox" Header="请求超时（秒）"
                                   Minimum="5" Maximum="3600" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </Expander>

                <!-- ===== 模型 ===== -->
                <Expander Header="模型" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <TextBlock x:Name="ModelSummaryText" Opacity="0.7" TextWrapping="Wrap" Text="" />

                        <ListView x:Name="ModelList" SelectionMode="None" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ModelRow">
                                    <Grid ColumnSpacing="10" Padding="0,6"
                                          AutomationProperties.Name="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                          用 Click 而不是 Checked/Unchecked：后两者**在程序化改值时也会触发**，
                                          而列表重建时 ListView 会复用行容器——复用的复选框还带着上一行的
                                          IsChecked，配上新行的 DataContext 就会去改**另一个模型**的开关。
                                          症状是"点一个模型，关掉的是另一个"，而且一次点击产生三条状态变更。
                                          Click 只在真实用户操作时触发，从根上避开这条时序。
                                        -->
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                                  Click="ModelEnabled_Changed"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="对外提供此模型" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="删除" Click="DeleteModel_Click"
                                                Visibility="{x:Bind DeleteVisibility}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewModelBox" Header="手工添加模型名"
                                     PlaceholderText="本地服务不实现 /models 时用这个" />
                            <Button Grid.Column="1" x:Name="AddModelButton" Content="添加"
                                    Click="AddModel_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="ModelAddHint" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                                   Text="加进当前选中的站点；没有选中时加进默认站点。手工条目在刷新模型时不会被删掉。" />

                        <TextBlock Text="模型名映射：接入方报的名字=站点要的名字，每行一条。未列出的原样透传。"
                                   TextWrapping="Wrap" Opacity="0.7" />
                        <TextBox x:Name="ModelMapBox" AcceptsReturn="True" Height="80"
                                 FontFamily="Consolas" PlaceholderText="gpt-4o=deepseek-chat" />
                    </StackPanel>
                </Expander>

                <!-- ===== 工具注入 ===== -->
                <Expander Header="工具注入" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="ToolsEnabledSwitch"
                                      Header="启用工具注入"
                                      OnContent="为请求注入词库查询工具"
                                      OffContent="关闭后不修改请求，纯转发" />
                        <ToggleSwitch x:Name="AnnounceToolsSwitch"
                                      Header="在系统提示里介绍工具"
                                      OnContent="推荐：否则模型不会想到用它"
                                      OffContent="只声明，不写进系统提示" />
                        <ToggleSwitch x:Name="CarryFindingsSwitch"
                                      Header="把查询结果一并放进响应"
                                      OnContent="仅当接入方还有工具要调用时（结果随它的历史留存）"
                                      OffContent="不放进响应" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" x:Name="MaxRoundsBox"
                                       Header="工具轮数上限（1-12）"
                                       Minimum="1" Maximum="12" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Column="1" x:Name="MaxCallsBox"
                                       Header="单次请求工具调用上限（1-64）"
                                       Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== 联网搜索 ===== -->
                <Expander Header="联网搜索" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="SearchEnabledSwitch"
                                      Header="给模型 web_search 工具"
                                      OnContent="模型可以自己决定上网查"
                                      OffContent="不下发这个工具"
                                      Toggled="SearchSetting_Changed" />
                        <TextBlock x:Name="SearchStatusText" TextWrapping="Wrap" Opacity="0.8" />

                        <ComboBox x:Name="SearchProviderBox" Header="后端"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="SearchProvider_Changed">
                            <ComboBoxItem Content="（未选择）" Tag="" />
                            <ComboBoxItem Content="SearXNG（自建实例，不需要密钥）" Tag="searxng" />
                            <ComboBoxItem Content="Tavily" Tag="tavily" />
                            <ComboBoxItem Content="Brave Search" Tag="brave" />
                            <ComboBoxItem Content="Serper（返回 Google 结果）" Tag="serper" />
                            <ComboBoxItem Content="shim（Anthropic 兼容搜索网关）" Tag="shim" />
                        </ComboBox>

                        <TextBox x:Name="SearchBaseUrlBox" Header="地址"
                                 PlaceholderText="http://127.0.0.1:8888"
                                 TextChanged="SearchSetting_TextChanged" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="SearchKeyBox" Header="API Key" />
                            <Button Grid.Column="1" x:Name="ClearSearchKeyButton" Content="清除密钥"
                                    Click="ClearSearchKey_Click" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                        </Grid>

                        <TextBox x:Name="SearchSniBox" Header="TLS SNI / Host（shim 需要时填）"
                                 PlaceholderText="留空则用地址里的主机名" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" x:Name="SearchMaxResultsBox"
                                       Header="结果条数（1-10）" Minimum="1" Maximum="10"
                                       SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Column="1" x:Name="SearchTimeoutBox"
                                       Header="超时（秒）" Minimum="5" Maximum="120"
                                       SpinButtonPlacementMode="Compact" />
                            <Button Grid.Column="2" x:Name="TestSearchButton" Content="测试搜索"
                                    Click="TestSearch_Click" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== 联网抓取 ===== -->
                <Expander Header="联网抓取" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="FetchEnabledSwitch"
                                      Header="给模型 web_fetch 工具"
                                      OnContent="模型可以自己决定读某个网页"
                                      OffContent="不下发这个工具"
                                      Toggled="FetchSetting_Changed" />
                        <TextBlock x:Name="FetchStatusText" TextWrapping="Wrap" Opacity="0.8" />

                        <ComboBox x:Name="FetchEngineBox" Header="引擎"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FetchEngine_Changed">
                            <ComboBoxItem Content="自动（先 HTTP，读不到正文才起浏览器）" Tag="auto" />
                            <ComboBoxItem Content="仅 HTTP（轻量，读不了 JS 页面）" Tag="http" />
                            <ComboBoxItem Content="仅浏览器（每次都渲染，较重）" Tag="browser" />
                        </ComboBox>

                        <TextBox x:Name="FetchProxyBox" Header="代理（留空 = 直连）"
                                 PlaceholderText="http://127.0.0.1:10809"
                                 TextChanged="FetchSetting_TextChanged" />

                        <TextBox x:Name="FetchBrowserPathBox"
                                 Header="浏览器可执行文件（留空 = 自动查找 Edge / Chrome）"
                                 TextChanged="FetchSetting_TextChanged" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" x:Name="FetchMaxCharsBox"
                                       Header="正文上限（字符）" Minimum="500" Maximum="200000"
                                       SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Column="1" x:Name="FetchTimeoutBox"
                                       Header="超时（秒）" Minimum="5" Maximum="180"
                                       SpinButtonPlacementMode="Compact" />
                        </Grid>

                        <!-- 临时目录清理：档位 + 自定义（数字 + 单位）。
                             选项由 Core 的 CleanupSchedule 填进来，**不在这里硬编码** ——
                             硬编码就会出现"界面写着 5 分钟、实际按别的秒数跑"这种没有症状的偏差。 -->
                        <ComboBox x:Name="FetchCleanupBox" Header="临时目录清理"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FetchCleanup_Changed" />

                        <Grid x:Name="FetchCleanupCustomRow" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" x:Name="FetchCleanupValueBox"
                                       Header="自定义清理时间" Minimum="1" Maximum="999999"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="FetchCleanupValue_Changed" />
                            <ComboBox Grid.Column="1" x:Name="FetchCleanupUnitBox" Header="单位"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="FetchCleanup_Changed" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="CleanupFetchButton" Content="立即清理"
                                    Click="CleanupFetch_Click" />
                            <!-- 清理结果**单独一行**，不复用上面的状态块：状态块是常驻说明，
                                 被一次性的反馈顶掉之后用户就看不到"这个设置会怎样"了。 -->
                            <TextBlock Grid.Column="1" x:Name="FetchCleanupResultText"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.8" />
                        </Grid>

                        <ToggleSwitch x:Name="FetchPrivateSwitch"
                                      Header="允许抓本机 / 内网地址"
                                      OnContent="允许（页面可能诱导模型访问内网）"
                                      OffContent="拦截（推荐）" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="FetchTestUrlBox" Header="测试地址"
                                     PlaceholderText="https://example.com/" />
                            <Button Grid.Column="1" x:Name="TestFetchButton" Content="测试抓取"
                                    Click="TestFetch_Click" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== 监听 ===== -->
                <Expander Header="监听" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <NumberBox x:Name="PortBox" Header="端口（1024-65535）"
                                   Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <ComboBox x:Name="ScopeBox" Header="允许连接的范围" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="仅本机（推荐）" Tag="local" />
                            <ComboBoxItem Content="仅局域网（私有网段）" Tag="lan" />
                            <ComboBoxItem Content="任意来源（不安全）" Tag="wan" />
                        </ComboBox>
                        <TextBlock Text="代理持有上游密钥，开放到网络等于交出密钥使用权。跨机请用 SSH 转发。"
                                   TextWrapping="Wrap" Opacity="0.7" />
                        <ToggleSwitch x:Name="RequireTokenSwitch"
                                      Header="要求接入方携带令牌"
                                      OnContent="推荐：无令牌时拒绝一切请求"
                                      OffContent="不鉴权（本机任何程序都可用你的额度）" />
                        <ToggleSwitch x:Name="LogBodiesSwitch"
                                      Header="把完整请求/响应体写进日志"
                                      OnContent="对话内容会落盘"
                                      OffContent="只记摘要" />
                    </StackPanel>
                </Expander>

                <!-- ===== MCP ===== -->
                <Expander Header="MCP 服务" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="McpEnabledSwitch"
                                      Header="把工具通过 MCP 暴露出去（POST /mcp）"
                                      OnContent="MCP 客户端连这个地址就能直接调工具"
                                      OffContent="关闭：这个端点不存在" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="McpUrlText" Text=""
                                       IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                       Opacity="0.85" />
                            <Button Grid.Column="1" x:Name="CopyMcpUrlButton" Content="复制"
                                    Click="CopyMcpUrl_Click" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="客户端里填上面的地址；鉴权用代理令牌（Authorization: Bearer aip-…），没有令牌时这个端点和其他端点一样拒绝一切。工具与注入给模型的是同一套：词库三个，配好联网搜索 / 抓取后还会多出 web_search / web_fetch。改这个开关要重启代理才生效。" />
                    </StackPanel>
                </Expander>

                <!-- ===== 令牌 ===== -->
                <Expander Header="代理令牌" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewTokenNameBox"
                                     Header="给哪个平台用" PlaceholderText="Claude Desktop" />
                            <TextBox Grid.Column="1" x:Name="NewTokenNoteBox"
                                     Header="备注（可选）" PlaceholderText="家里那台机器" />
                            <Button Grid.Column="2" x:Name="CreateTokenButton" Content="签发新令牌"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CreateToken_Click" VerticalAlignment="Bottom" />
                        </Grid>

                        <TextBlock x:Name="TokenSummaryText" Opacity="0.7" Text="" />

                        <ListView x:Name="TokenList" SelectionMode="None" MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TokenRow">
                                    <!-- AutomationProperties.Name：不设的话读屏器念的是
                                         内部类型名 AnimaAIProxy.TokenRow。 -->
                                    <Grid ColumnSpacing="10" Padding="0,6"
                                          AutomationProperties.Name="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                      OnContent="启用" OffContent="停用"
                                                      Toggled="TokenToggled" />
                                        <Button Grid.Column="2" Content="删除" Click="DeleteToken_Click"
                                                Tag="{x:Bind Id}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <!-- ===== 词库 ===== -->
                <Expander Header="词库" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <TextBlock x:Name="VocabStatusText" TextWrapping="Wrap" />
                        <TextBox x:Name="VocabPathBox" Header="vocab.sqlite 路径" />
                        <TextBox x:Name="SeedPathBox" Header="seed.json 路径（可选）" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="ReloadVocabButton" Content="重新载入"
                                    Click="ReloadVocab_Click" />
                            <TextBlock Grid.Column="1" Text="默认沿用 AnimaCaptioner 的词库路径。"
                                       TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== 日志 ===== -->
                <Expander Header="实时日志" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="清空面板" Click="ClearLog_Click" />
                            <Button Grid.Column="1" Content="打开日志文件" Click="OpenLogFile_Click" />
                            <Button Grid.Column="2" Content="打开配置目录" Click="OpenConfigDir_Click" />
                            <TextBlock Grid.Column="3" x:Name="LogPathText" Opacity="0.6"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ListView x:Name="LogList" SelectionMode="None" MaxHeight="320"
                                  FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
